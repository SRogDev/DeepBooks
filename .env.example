# Feature flags (see lib/flags.ts)
# Social network: removed from MVP, post-MVP reintroduction
NEXT_PUBLIC_FEATURE_SOCIAL=false
# Small marketplace where people upload books directly
NEXT_PUBLIC_FEATURE_MARKETPLACE=true
# Random ambient generative moments while reading
NEXT_PUBLIC_FEATURE_AMBIENT=true

# Supabase — Roger: crea el proyecto en supabase.com y aplica
# supabase/migrations/001_init.sql en el SQL editor
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: solo en el servidor (route handlers de ingesta).
# Nunca la expongas con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter — embeddings (text-embedding-3-small) en la ingesta;
# LLMs en Fase 2 (motor generativo)
OPENROUTER_API_KEY=
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
